# 한국은행 ECOS (경제통계시스템) API 인증키 (필수)
# 발급: https://ecos.bok.or.kr/api/  → 로그인 → 인증키 신청
ECOS_API_KEY=your_ecos_api_key_here

# FRED API 키 (필수)
# 발급: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# 캐시 갱신 임계값 (시간) — 이 시간보다 오래된 데이터면 외부 API 재호출
CACHE_TTL_HOURS=4

# CORS 허용 origin (콤마 구분)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
